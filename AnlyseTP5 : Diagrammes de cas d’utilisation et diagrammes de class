Ex. 1 Simulation d’un reseau ferroviaire


@startuml
class LigneFerroviaire {
}
class Gare {
    - nom: String
}
class Train {
    +setOrigine(o: Gare)
    +setArrivee(a: Gare)
}
class Capteur {
}
class Barriere {
    - estOuverte: bool
    - estFermee: bool
}

Gare "2..*"--"1..*" LigneFerroviaire : traverse/est traverser
Train "0..*"..>"0..*" LigneFerroviaire : Utiliser

Train "*"-->"1" Gare: GareOrigine
Train "*"-->"1" Gare: GareArrivee

Capteur "*"<--"1" LigneFerroviaire : Posseder

Capteur "1"--"1" Barriere : controller

@enduml

